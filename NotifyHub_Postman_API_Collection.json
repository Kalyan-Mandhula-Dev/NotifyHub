{
  "info": {
    "name": "NotifyHub",
    "description": "NotifyHub API Collection — all requests go through the API Gateway (port 8080). Register or log in first, then set the 'token' collection variable to the returned JWT before running any other request.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "token", "value": "" },
    { "key": "tenantId", "value": "" },
    { "key": "subscriptionId", "value": "" },
    { "key": "templateId", "value": "" }
  ],
  "item": [
    {
      "name": "1. Auth Service",
      "item": [
        {
          "name": "Register Tenant",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"companyName\": \"Swiggy\",\n  \"email\": \"tech@swiggy.com\",\n  \"password\": \"Swiggy@123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "register"]
            },
            "description": "Open route — no JWT required."
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"tech@swiggy.com\",\n  \"password\": \"Swiggy@123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            },
            "description": "Open route — no JWT required. Copy the returned token into the 'token' collection variable."
          }
        },
        {
          "name": "Validate Token",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/auth/validate",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "validate"]
            }
          }
        }
      ]
    },
    {
      "name": "2. User Service",
      "item": [
        {
          "name": "Get Tenant by ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/users/tenants/{{tenantId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users", "tenants", "{{tenantId}}"]
            }
          }
        },
        {
          "name": "Update Tenant",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"companyName\": \"Swiggy India\",\n  \"email\": \"tech@swiggy.com\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/users/tenants/{{tenantId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users", "tenants", "{{tenantId}}"]
            }
          }
        },
        {
          "name": "Deactivate Tenant",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/users/tenants/{{tenantId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users", "tenants", "{{tenantId}}"]
            }
          }
        },
        {
          "name": "Add Email Subscription",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tenantId\": \"{{tenantId}}\",\n  \"channel\": \"EMAIL\",\n  \"destination\": \"notifications@swiggy.com\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/users/subscriptions",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users", "subscriptions"]
            }
          }
        },
        {
          "name": "Add Webhook Subscription",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tenantId\": \"{{tenantId}}\",\n  \"channel\": \"WEBHOOK\",\n  \"destination\": \"https://webhook.site/your-test-url\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/users/subscriptions",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users", "subscriptions"]
            }
          }
        },
        {
          "name": "Get Subscriptions",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/users/subscriptions/{{tenantId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users", "subscriptions", "{{tenantId}}"]
            }
          }
        },
        {
          "name": "Delete Subscription",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/users/subscriptions/{{subscriptionId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users", "subscriptions", "{{subscriptionId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "3. Event Service",
      "item": [
        {
          "name": "Trigger Email Event - Order Placed",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"eventType\": \"order.placed\",\n  \"channel\": \"EMAIL\",\n  \"recipient\": \"PASTE_YOUR_REAL_EMAIL_HERE\",\n  \"payload\": {\n    \"orderId\": \"SWG123\",\n    \"restaurantName\": \"Biryani House\",\n    \"amount\": 349\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/events/trigger",
              "host": ["{{baseUrl}}"],
              "path": ["api", "events", "trigger"]
            },
            "description": "tenantId is no longer sent in the body — the Gateway injects it from the verified JWT as X-Tenant-Id."
          }
        },
        {
          "name": "Trigger Email Event - Payment Failed",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"eventType\": \"payment.failed\",\n  \"channel\": \"EMAIL\",\n  \"recipient\": \"PASTE_YOUR_REAL_EMAIL_HERE\",\n  \"payload\": {\n    \"orderId\": \"SWG456\",\n    \"amount\": 299,\n    \"reason\": \"Insufficient funds\"\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/events/trigger",
              "host": ["{{baseUrl}}"],
              "path": ["api", "events", "trigger"]
            }
          }
        },
        {
          "name": "Trigger Webhook Event",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"eventType\": \"order.delivered\",\n  \"channel\": \"WEBHOOK\",\n  \"recipient\": \"https://webhook.site/your-test-url\",\n  \"payload\": {\n    \"orderId\": \"SWG789\",\n    \"deliveredAt\": \"2026-05-17T10:30:00\",\n    \"deliveryAgent\": \"Ravi\"\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/events/trigger",
              "host": ["{{baseUrl}}"],
              "path": ["api", "events", "trigger"]
            }
          }
        },
        {
          "name": "Get Events by Tenant",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/events/{{tenantId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "events", "{{tenantId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "4. Notification Service",
      "item": [
        {
          "name": "Get Delivery History",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/notifications/history/{{tenantId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "notifications", "history", "{{tenantId}}"]
            }
          }
        },
        {
          "name": "Get Delivery Stats",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/notifications/stats/{{tenantId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "notifications", "stats", "{{tenantId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "5. Template Service",
      "item": [
        {
          "name": "Upload Template",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "tenantId", "value": "{{tenantId}}", "type": "text" },
                { "key": "eventType", "value": "order.placed", "type": "text" },
                { "key": "templateName", "value": "order-confirmation", "type": "text" },
                { "key": "file", "type": "file", "src": [], "description": "Select your order-confirmation.html file" }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/templates",
              "host": ["{{baseUrl}}"],
              "path": ["api", "templates"]
            }
          }
        },
        {
          "name": "Resolve Template",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/templates/resolve?tenantId={{tenantId}}&eventType=order.placed",
              "host": ["{{baseUrl}}"],
              "path": ["api", "templates", "resolve"],
              "query": [
                { "key": "tenantId", "value": "{{tenantId}}" },
                { "key": "eventType", "value": "order.placed" }
              ]
            }
          }
        },
        {
          "name": "Get All Templates for Tenant",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/templates/tenant/{{tenantId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "templates", "tenant", "{{tenantId}}"]
            }
          }
        },
        {
          "name": "Delete Template",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/templates/{{templateId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "templates", "{{templateId}}"]
            }
          }
        }
      ]
    }
  ]
}
