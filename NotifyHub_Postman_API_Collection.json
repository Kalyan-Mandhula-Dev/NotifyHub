              "mode": "raw",
              "raw": "{\n  \"companyName\": \"Swiggy\",\n  \"email\": \"tech@swiggy.com\",\n  \"password\": \"Swiggy@123\"\n}"
            },
            "url": {
              "raw": "http://localhost:8081/api/auth/register",
